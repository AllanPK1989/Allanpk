                  {
                    "value": "How this is calculated   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#0C3549",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Every technician signs in with the same M365 account, so the mandatory Technician Name dropdown on each form is the entire attribution trail. It is never optional and never free text.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Findings Raised per PM measures thoroughness. Ranking people by 'fewest findings' teaches them to stop reporting - the number then looks excellent and means nothing.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Avg Task Duration compared against the checklist's Expected_Time_Min is how a pencil-whipped PM is caught.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
