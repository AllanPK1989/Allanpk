                "textRuns": [
                  {
                    "value": "How this is calculated   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#0C3549",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Breakdowns After PM (7d) counts breakdowns on a cell within 7 days of a completed PM on that same cell, derived from dates rather than from Linked_PM_WO, so it works on history loaded before the flow existed.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Availability % = (loading hours - downtime hours) / loading hours, where downtime uses production loss minutes, not MTTR.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "MTBF (Hrs) = loading hours / breakdown count. Loading hours are the standard hours actually consumed.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
