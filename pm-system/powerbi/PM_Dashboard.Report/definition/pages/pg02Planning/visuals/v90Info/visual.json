                  {
                    "value": "How this is calculated   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#0C3549",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Projected PM Date = today + ROUNDUP(Hours to Next PM / Avg Monthly Std Hours L3M) months.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Rounded UP: a cell needing 1.2 months of running is due in the second month, not the first.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Calendar Due Date = Last_PM_Date + the cell's own Calendar_Backstop_Months.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Forecast Man-Hours comes from summed Expected_Time_Min in the checklist master, not from past actuals.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
