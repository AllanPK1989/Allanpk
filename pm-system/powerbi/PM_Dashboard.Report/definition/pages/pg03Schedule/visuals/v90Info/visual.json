                  {
                    "value": "How this is calculated   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#0C3549",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Adherence is measured against PM_Plan_Calendar (frozen on the 25th), not against the work order's own planned date, which can be edited after the fact.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Plan_Version 'V1 Forecast' rows are projections beyond the frozen month and never count in the denominator.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "The Gantt bars are a stacked bar: an invisible offset series then a visible duration series.   ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#7B8794",
