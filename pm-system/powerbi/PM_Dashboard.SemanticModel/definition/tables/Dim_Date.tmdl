table Dim_Date
	lineageTag: de34047f-1683-5fa4-94bd-dc9c37f2e3fe

	/// Generated in DAX and marked as the model's date table. The range covers
	/// two Indian financial years, 2025-04-01 to 2027-03-31, so a report opened
	/// in the current year still has next year's forecast dates to land on.
	/// Marking it as a date table is what makes the time intelligence functions
	/// work; without it they silently return wrong answers rather than erroring.

	column Date
		dataType: dateTime
		lineageTag: b433e0a1-35d3-50ae-b5c8-eafdefd76352
		summarizeBy: none
		sourceColumn: [Date]
		formatString: yyyy-mm-dd
		isKey

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		lineageTag: 4e171c53-78a8-5bf5-a591-eea758de81cd
