	/// Planned work orders in the month, using the INACTIVE Planned_End_Date relationship.
	/// This is what the inactive relationships exist for: one month slicer, two different questions - what did we plan for March, and what did we finish in March.
	measure 'Planned WO Count' = ```
			CALCULATE (
			    COUNTROWS ( Fact_WorkOrder ),
			    USERELATIONSHIP ( Fact_WorkOrder[Planned_End_Date], Dim_Date[Date] ),
			    KEEPFILTERS ( Fact_WorkOrder[WO_Status] <> "Cancelled" )
			) + 0
			```
		formatString: #,##0
		displayFolder: 09 Forecast & Schedule Helpers
		lineageTag: cd75fdfe-2986-51ed-ad90-d81793f9c278

	measure 'Completed WO Count (by Actual Date)' = ```
			CALCULATE (
			    COUNTROWS ( Fact_WorkOrder ),
			    USERELATIONSHIP ( Fact_WorkOrder[Actual_End_Date], Dim_Date[Date] ),
			    KEEPFILTERS ( Fact_WorkOrder[WO_Status] = "Completed" )
			) + 0
			```
		formatString: #,##0.00
		displayFolder: 09 Forecast & Schedule Helpers
		lineageTag: 6fb159f4-5234-55b1-9212-859facbf5a06

