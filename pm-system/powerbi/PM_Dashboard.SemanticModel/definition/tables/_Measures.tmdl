	measure 'Gantt Planned Offset (Days)' = ```
			VAR Origin = [Gantt Origin Date]
			VAR Start = MIN ( Fact_WorkOrder[Planned_Start_Date] )
			RETURN
			    IF ( NOT ISBLANK ( Start ) && NOT ISBLANK ( Origin ), DATEDIFF ( Origin, Start, DAY ) )
			```
		formatString: #,##0.0
		displayFolder: 09 Forecast & Schedule Helpers
		lineageTag: bd9336f2-c35b-5bf5-b99b-0ce7487db7f9

	measure 'Gantt Planned Duration (Days)' = ```
			VAR S = MIN ( Fact_WorkOrder[Planned_Start_Date] )
			VAR E = MAX ( Fact_WorkOrder[Planned_End_Date] )
			RETURN
			    IF ( NOT ISBLANK ( S ) && NOT ISBLANK ( E ), DATEDIFF ( S, E, DAY ) + 1 )
