	/// Approved but not yet issued.
	/// The gap nobody watches, because the approver's job is done and the storekeeper was never told there was a clock running.
	measure 'Approved Not Issued Count' = ```
			CALCULATE (
			    COUNTROWS ( Fact_SpareRequest ),
