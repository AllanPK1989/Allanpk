	/// Attribution rests entirely on the Completed_By dropdown, because every technician signs in with the same M365 account.
	/// That is why the field is mandatory on every form and why it is never free text.
	measure 'PMs Completed by Tech' = ```
			CALCULATE (
			    COUNTROWS ( Fact_MachineTask ),
			    KEEPFILTERS ( Fact_MachineTask[Task_Status] = "Completed" )
			) + 0
			```
		formatString: #,##0.00
		displayFolder: 07 Technician
		lineageTag: 8879b648-9e71-57cd-ba16-8ee27ad446de

	measure 'Avg Task Duration by Tech' = ```
			AVERAGEX (
			    FILTER (
			        Fact_MachineTask,
			        Fact_MachineTask[Task_Status] = "Completed"
			            && NOT ISBLANK ( Fact_MachineTask[Duration_Min] )
			            && Fact_MachineTask[Duration_Min] > 0
			    ),
			    Fact_MachineTask[Duration_Min]
			)
			```
		formatString: #,##0.00
		displayFolder: 07 Technician
		lineageTag: 5fdc9b96-8f5e-57c9-a046-944ac89523f6

	/// Findings per completed task.
	/// Read this as thoroughness, not as fault.
	/// A technician who raises more findings per PM is looking harder, and the one at the bottom of this chart is the one to review - not the one at the top.
	/// Label it that way on the page, every time, or within a month people will stop reporting findings to protect their number.
	measure 'Findings Raised per PM' = ```
			DIVIDE (
			    CALCULATE (
			        SUM ( Fact_MachineTask[NOT_OK_Count] ),
			        KEEPFILTERS ( Fact_MachineTask[Task_Status] = "Completed" )
			    ),
			    [Machine Tasks Completed]
			)
			```
		formatString: #,##0.00
		displayFolder: 07 Technician
		lineageTag: 8de5e99f-d8e1-5285-ac5c-3100606f21ec

	measure 'Abnormalities Raised by Tech' = ```
			COUNTROWS ( Fact_Abnormality ) + 0
			```
		formatString: #,##0.00
		displayFolder: 07 Technician
		lineageTag: 2403511e-7a4d-5c74-a715-2a3183995764

	/// Distinct technicians who completed work in the period.
	/// The workload-balance denominator.
	measure 'Active Technicians' = ```
			CALCULATE (
			    DISTINCTCOUNT ( Fact_MachineTask[Completed_By] ),
			    KEEPFILTERS ( Fact_MachineTask[Task_Status] = "Completed" )
			) + 0
			```
		formatString: #,##0.00
		displayFolder: 07 Technician
		lineageTag: d5a6fd8c-30fb-554d-8a4f-8919be6f075b

	/// How unevenly work is spread.
	/// Zero means perfectly balanced.
	/// A high value with six technicians on the roster usually means two of them are doing the PMs and four are on breakdowns.
	measure 'Workload Imbalance' = ```
			VAR PerTech =
			    ADDCOLUMNS (
			        VALUES ( Dim_Technician[Tech_ID] ),
			        "@Tasks", CALCULATE ( [Machine Tasks Completed] )
			    )
			VAR MaxT = MAXX ( PerTech, [@Tasks] )
			VAR MinT = MINX ( PerTech, [@Tasks] )
			RETURN
			    IF ( COUNTROWS ( PerTech ) > 1, MaxT - MinT )
			```
		formatString: #,##0.00
		displayFolder: 07 Technician
		lineageTag: 6ca2d12a-7274-56f5-8055-c2b0501dbcab

	/// Titles that state the question the visual answers, with the live figure in them.
	/// A title that changes with the filter is read; a static one is not.
	measure 'Title - Cells At Risk' = ```
			"Which cells are at or past 90% of their PM trigger?  ("
			    & FORMAT ( [Cells Due Soon Count], "0" ) & " of "
			    & FORMAT ( COUNTROWS ( FILTER ( Dim_Cell, Dim_Cell[Active] = TRUE () ) ), "0" ) & " cells)"
			```
		displayFolder: 08 Utility
		lineageTag: 46f5a444-1c80-5f86-8478-be3576f24c6a

	measure 'Title - Breakdowns After PM' = ```
			"Breakdowns within 7 days of a completed PM  -  "
			    & FORMAT ( [Breakdowns After PM (7d)], "0" ) & " of "
			    & FORMAT ( [Breakdown Count], "0" ) & " breakdowns ("
			    & FORMAT ( [Breakdowns After PM %], "0.0%" ) & ").  A rising share means the PM is not working."
			```
		displayFolder: 08 Utility
		lineageTag: 56e49023-1c69-50f9-9bce-a942671684f6

	/// Colour helper for compliance, using the theme's positive / warning / negative.
	measure 'Compliance Colour' = ```
			VAR C = [PM Compliance %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( C ), "#7B8794", C >= 0.95, "#44C088", C >= 0.85, "#F0A202", "#ED7373" )
			```
		displayFolder: 08 Utility
		lineageTag: 0c202cf6-34ef-5e12-9daf-4add7ff87142

	measure 'Availability Colour' = ```
			VAR A = [Availability %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( A ), "#7B8794", A >= 0.95, "#44C088", A >= 0.9, "#F0A202", "#ED7373" )
			```
		displayFolder: 08 Utility
		lineageTag: 461fab05-4299-5f18-9dce-0be2f705d6ee

	/// Expected man-hours to PM one whole cell, summed from the checklist master across that cell's active machines.
	/// This is the number you show production when you ask for a window.
	/// It is built from what the checklist actually says, not from what last time happened to take, so it does not quietly inflate as the team gets slower.
	measure 'Cell Expected PM Hours' = ```
			DIVIDE (
			    SUMX (
			        FILTER ( Dim_Machine, Dim_Machine[Active] = TRUE () ),
			        VAR ChecklistId = Dim_Machine[Checklist_ID]
			        RETURN
			            CALCULATE (
			                SUM ( Dim_ChecklistItem[Expected_Time_Min] ),
			                REMOVEFILTERS ( Dim_ChecklistItem ),
			                Dim_ChecklistItem[Checklist_ID] = ChecklistId,
			                Dim_ChecklistItem[Active] = TRUE ()
			            )
			    ),
			    60
			)
			```
		formatString: #,##0
		displayFolder: 09 Forecast & Schedule Helpers
		lineageTag: d37dc870-e67d-5d27-9f9c-57f29443ffcf

	/// How many cell PMs are projected to fall in the month on the axis.
	/// This is the workload forecast, and it is the only visual on the planning page that answers "how many technicians do I need in November".
	/// Dim_Cell has no relationship to Dim_Date - deliberately, since the counter is a snapshot - so the month window is read off the axis with MIN/MAX and each cell's own due date is compared against it.
	measure 'Forecast PM Count' = ```
			VAR MonthStart = MIN ( Dim_Date[Date] )
			VAR MonthEnd = MAX ( Dim_Date[Date] )
			VAR CellsWithDue =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Dim_Cell[Cell_ID] ),
			            REMOVEFILTERS ( Dim_Date ),
			            Dim_Cell[Active] = TRUE ()
			        ),
			        "@Due", CALCULATE ( [Next PM Due Date], REMOVEFILTERS ( Dim_Date ) )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            CellsWithDue,
			            NOT ISBLANK ( [@Due] ) && [@Due] >= MonthStart && [@Due] <= MonthEnd
			        )
			    ) + 0
			```
		formatString: #,##0
		displayFolder: 09 Forecast & Schedule Helpers
		lineageTag: 89df0f84-9ada-56ca-a3d5-b72bb0a57d8a

	/// The same forecast expressed in man-hours, which is what a shift plan is actually built from.
	/// Three cells due in one month is meaningless until you know whether that is 12 hours or 60.
	measure 'Forecast Man-Hours' = ```
			VAR MonthStart = MIN ( Dim_Date[Date] )
			VAR MonthEnd = MAX ( Dim_Date[Date] )
			VAR CellsWithDue =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( Dim_Cell[Cell_ID] ),
			            REMOVEFILTERS ( Dim_Date ),
			            Dim_Cell[Active] = TRUE ()
			        ),
			        "@Due", CALCULATE ( [Next PM Due Date], REMOVEFILTERS ( Dim_Date ) ),
			        "@Hrs", CALCULATE ( [Cell Expected PM Hours], REMOVEFILTERS ( Dim_Date ) )
			    )
			RETURN
			    SUMX (
			        FILTER (
			            CellsWithDue,
			            NOT ISBLANK ( [@Due] ) && [@Due] >= MonthStart && [@Due] <= MonthEnd
			        ),
			        [@Hrs]
			    )
			```
		formatString: #,##0
		displayFolder: 09 Forecast & Schedule Helpers
		lineageTag: 6c287ff1-edc7-503f-8896-a557dea099d1

	/// Spare spend in the month currently in context, for the executive KPI row.
	measure 'Spare Cost MTD' = ```
			CALCULATE ( [Spare Cost], DATESMTD ( Dim_Date[Date] ) )
			```
		formatString: "₹"#,##0
		displayFolder: 09 Forecast & Schedule Helpers
		lineageTag: 86fe0a15-dc33-5e67-8c44-bbafa81ffe71

	/// Gantt-style planned-vs-actual bars.
	/// Power BI has no native Gantt.
	/// The standard construction is a stacked bar with two series: an INVISIBLE offset bar that pushes the visible bar to the right, then the visible duration bar.
	/// Set the offset series to no fill in the visual and what remains reads as a timeline.
	/// The origin is the earliest planned start in the current selection, so the chart re-bases itself when the month slicer moves rather than always starting at some fixed date far off screen.
	measure 'Gantt Origin Date' = ```
			CALCULATE (
			    MIN ( Fact_WorkOrder[Planned_Start_Date] ),
			    ALLSELECTED ( Fact_WorkOrder )
			)
			```
		formatString: yyyy-mm-dd
		displayFolder: 09 Forecast & Schedule Helpers
