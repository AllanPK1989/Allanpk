	/// Spare cost divided by the number of completed cell PMs.
	/// The unit cost of a preventive maintenance, which is the number a finance review will ask for.
	measure 'Spare Cost per PM' = ```
			DIVIDE (
			    CALCULATE ( [Spare Cost], KEEPFILTERS ( Fact_SpareReplaced[Source_Type] = "PM" ) ),
			    [PM Completed Count]
			)
			```
		formatString: "₹"#,##0
		displayFolder: 06 Spares
		lineageTag: 5086b4dd-9b1e-5328-b3c8-1e7a9aa44e0e

	/// Planned versus unplanned spend.
	/// Splitting these is the point of Source_Type.
	measure 'Planned Spare Cost' = ```
			CALCULATE ( [Spare Cost], KEEPFILTERS ( Fact_SpareReplaced[Source_Type] = "PM" ) )
			```
