	measure 'Gantt Actual Duration (Days)' = ```
			VAR S = MIN ( Fact_WorkOrder[Actual_Start_Date] )
			VAR E = MAX ( Fact_WorkOrder[Actual_End_Date] )
			RETURN
			    IF ( NOT ISBLANK ( S ) && NOT ISBLANK ( E ), DATEDIFF ( S, E, DAY ) + 1 )
