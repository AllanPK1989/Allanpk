	/// Counted over active parts only.
	/// A superseded part sitting at zero stock is not a stock-out, and counting it hides the ones that are.
	measure 'Stock Below Min Count' = ```
			COUNTROWS (
			    FILTER (
			        Dim_Spare,
			        Dim_Spare[Active] = TRUE ()
			            && NOT ISBLANK ( Dim_Spare[Current_Stock] )
			            && NOT ISBLANK ( Dim_Spare[Min_Stock] )
			            && Dim_Spare[Current_Stock] <= Dim_Spare[Min_Stock]
			    )
			) + 0
			```
		formatString: #,##0
		displayFolder: 06 Spares
		lineageTag: 82b924d8-8c93-5b8f-97a3-d2ba006eb8df

	measure 'Stock Value (INR)' = ```
			SUMX ( Dim_Spare, Dim_Spare[Current_Stock] * Dim_Spare[Unit_Cost_INR] )
			```
		formatString: #,##0
		displayFolder: 06 Spares
		lineageTag: 178ccf48-3580-5ada-9322-dc04c8151899

	measure 'Warranty Claims Flagged' = ```
			CALCULATE (
			    COUNTROWS ( Fact_SpareReplaced ),
			    KEEPFILTERS ( Fact_SpareReplaced[Warranty_Claim] = TRUE () )
			) + 0
			```
