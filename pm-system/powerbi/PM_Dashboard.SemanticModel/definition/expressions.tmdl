		// Trailing separator is not required - fnGetTable normalises it.
		// ===========================================================================
		"C:\EPQPL_PM\input" meta [
		    IsParameterQuery = true,
		    Type = type text,
		    IsParameterQueryRequired = true,
		    DefaultValue = "C:\EPQPL_PM\input"
