# Copy to .env, fill in, then:  docker compose up -d
# Leave a line out (or empty) to keep the default shown.

# ---- Going live ------------------------------------------------------------------------------
# Start with an empty app instead of the demo tasks. (To remove demo tasks from an existing
# install: docker compose exec api python -m app.cli clear-sample)
SEED_SAMPLE_DATA=false
# Your PIN on first start (4 to 8 digits). Leave empty to choose it in the app instead.
INITIAL_PIN=
ENVIRONMENT=production
# The address you open Nudge at; used for links in e-mails.
PUBLIC_BASE_URL=https://localhost
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Claude (understands your voice notes) ----------------------------------------------------
# Without a key Nudge uses its built-in rules, which handle everyday phrasing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# ---- Speech to text ----------------------------------------------------------------------------
# small.en is accurate for Indian English; base.en is faster on a small server.
WHISPER_MODEL=small.en

# ---- E-mail digest ------------------------------------------------------------------------------
# Gmail: create an App Password (Google Account → Security → App passwords) and use
# smtp.gmail.com, port 587, your address as the user and the app password below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Where the digest goes (can also be set in Settings).
DIGEST_TO=

# ---- Push notifications -------------------------------------------------------------------------
# Keys are generated on first start. Put a real contact address here (some push services
# reject placeholder addresses).
VAPID_SUBJECT=mailto:you@example.com

# ---- Web address and HTTPS ------------------------------------------------------------------------
SITE_ADDRESS=localhost
CADDY_TLS=internal
HTTP_PORT=80
HTTPS_PORT=443
