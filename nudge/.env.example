# Copy to .env, fill in what you need, then:  docker compose up -d
# Everything here is optional and free. Nudge needs no accounts, API keys or paid services.

# ---- Going live ------------------------------------------------------------------------------
# Start with an empty app instead of the demo tasks. (To remove demo tasks from an existing
# install: docker compose exec api python -m app.cli clear-sample)
SEED_SAMPLE_DATA=false
# Your PIN on first start (4 to 8 digits). Leave empty to choose it in the app instead.
INITIAL_PIN=
ENVIRONMENT=production
# The address you open Nudge at; only used for the link inside digest e-mails.
PUBLIC_BASE_URL=https://localhost
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Speech to text (runs on this machine) ------------------------------------------------------
# small.en is accurate for Indian English; base.en is faster on a small or older computer.
WHISPER_MODEL=small.en
# After the first start has downloaded the model, set to 1 so the speech server never goes online.
WHISPER_OFFLINE=0

# ---- Web address and HTTPS (no e-mail or account needed for any mode) -----------------------------
# internal: Caddy's own certificate; install it on your phone once (RUNBOOK.md step 3). Free, private.
# public:   free Let's Encrypt certificate for a real domain pointing at this machine.
# files:    your own certificate in ./certs/cert.pem and ./certs/key.pem
SITE_ADDRESS=localhost
TLS_MODE=internal
HTTP_PORT=80
HTTPS_PORT=443

# ---- E-mail digest (optional, off unless you fill this in) ---------------------------------------
# The digest lists your tasks, so it passes through whichever mail provider you use here.
# Leave SMTP_HOST empty to keep everything on this machine (push reminders still work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
DIGEST_TO=

# ---- Push notifications ---------------------------------------------------------------------------
# Keys are generated on first start. The contact below is shown to push services (Google, Apple,
# Mozilla); the placeholder works, so you don't need to give your own address.
VAPID_SUBJECT=mailto:nudge-reminders@example.com
