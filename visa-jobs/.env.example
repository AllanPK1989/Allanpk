# Copy this file to .env and fill in your values. .env is never committed.

# Adzuna API (free key): sign up at https://developer.adzuna.com/signup
# Without these, the app still works using Arbeitnow (and the remote-job feeds).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Requests per day the app may make to Adzuna. Check your plan's limit in your
# Adzuna account and set this at or below it. Each country searched = 1 request.
ADZUNA_DAILY_LIMIT=250

# Where the app listens. Keep 127.0.0.1 so only this computer can open it.
HOST=127.0.0.1
PORT=8080

# Where saved jobs, cache and sponsor registers are stored.
DATA_DIR=./data

# Sponsor registers are refreshed automatically when older than this many days.
REGISTER_MAX_AGE_DAYS=7
AUTO_UPDATE_REGISTERS=1

# How many pages (100-300 jobs each, cached 2 hours) to read from Arbeitnow's visa-sponsorship feed.
ARBEITNOW_PAGES=8
