rules_version = '2';

// Expense & Budget Manager — Firestore security rules.
//
// Data model:
//   users/{uid}                        one document per signed-in user
//   households/{hid}                   a personal or family space
//   households/{hid}/<collection>/{id} accounts, categories, transactions,
//                                      budgets, goals, recurring, activity
//   invites/{code}                     maps an 8-char invite code to a household
//
// Membership is checked against households/{hid}.memberIds. Private
// transactions are filtered by the app (it only queries entries that are
// shared or created by the caller); rules keep every household document
// scoped to members so no outsider can ever read a family's ledger.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in household(hid).memberIds;
    }

    function roleOf(hid) {
      return household(hid).members[request.auth.uid].role;
    }

    function isAdultOrOwner(hid) {
      return isMember(hid) && roleOf(hid) in ['owner', 'adult'];
    }

    function isOwner(hid) {
      return isMember(hid) && household(hid).ownerId == request.auth.uid;
    }

    // Write-time variants. getAfter() sees the household as it will be once
    // the current batch/transaction commits, which is what makes "create a
    // household and its default categories in one batch" and "join, then log
    // an activity entry" possible.
    function householdAfter(hid) {
      return getAfter(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMemberW(hid) {
      return signedIn() && request.auth.uid in householdAfter(hid).memberIds;
    }

    function isAdultOrOwnerW(hid) {
      return isMemberW(hid) && householdAfter(hid).members[request.auth.uid].role in ['owner', 'adult'];
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // Owners removing a member may prune that member's householdIds.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdIds']);
    }

    // -------------------------------------------------------------- invites
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && isOwner(resource.data.householdId);
    }

    // ----------------------------------------------------------- households
    match /households/{hid} {
      allow read: if isMember(hid);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Members with adult/owner role may edit settings. A signed-in
      // non-member may add themselves if they present the current invite
      // code in their own member entry and touch nothing else.
      allow update: if isAdultOrOwner(hid)
        || (signedIn()
            && !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
            && request.resource.data.members[request.auth.uid].inviteCode == resource.data.inviteCode)
        // A member may leave (remove only themselves).
        || (isMember(hid)
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']));

      allow delete: if isOwner(hid);

      match /accounts/{id} {
        allow read: if isMember(hid);
        allow write: if isAdultOrOwnerW(hid);
      }

      match /categories/{id} {
        allow read: if isMember(hid);
        allow write: if isAdultOrOwnerW(hid);
      }

      match /transactions/{id} {
        allow read: if isMember(hid);
        allow create: if isMemberW(hid) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdultOrOwnerW(hid)
          || (isMemberW(hid) && resource.data.createdBy == request.auth.uid);
      }

      match /budgets/{id} {
        allow read: if isMember(hid);
        allow write: if isAdultOrOwnerW(hid);
      }

      match /goals/{id} {
        allow read: if isMember(hid);
        allow create, update: if isMemberW(hid);
        allow delete: if isAdultOrOwnerW(hid);
      }

      match /recurring/{id} {
        allow read: if isMember(hid);
        allow create: if isMemberW(hid) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdultOrOwnerW(hid)
          || (isMemberW(hid) && resource.data.createdBy == request.auth.uid);
      }

      match /activity/{id} {
        allow read: if isMember(hid);
        allow create: if isMemberW(hid) && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
