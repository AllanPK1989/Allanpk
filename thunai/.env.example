# Copy to .env and fill in. Never commit .env. Restart with: docker compose up -d

# --- Core -------------------------------------------------------------------------------------
ENVIRONMENT=production
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
# The address phones open, and the base of every QR code. Must match SITE_ADDRESS.
PUBLIC_BASE_URL=https://thunai.plant.local
SITE_ADDRESS=thunai.plant.local
# internal = Caddy's own CA (install root cert on phones); or an e-mail for public ACME;
# or "/certs/cert.pem /certs/key.pem" for a certificate from IT placed in ./certs
CADDY_TLS=internal
PLANT_TZ=Asia/Kolkata
TOKEN_HOURS=12
# First start on an empty database: seed SAMPLE data (DEMO- machines, D- users, PIN 1234).
# Set to false for the real pilot and create the first admin with app.cli create-admin.
SEED_SAMPLE_DATA=false

# --- AI ---------------------------------------------------------------------------------------
# Thunai's rules engine (the only option since the move to Microsoft Copilot, SPEC section 13).
AI_PROVIDER=rules
# Prompt versions in backend/prompts, e.g. troubleshoot=v1 to go back (defaults: troubleshoot
# and clarify v2, the rest v1). Only used if a model adapter is added later.
PROMPT_VERSIONS=

# --- Microsoft Copilot (SPEC section 13, steps in copilot/SETUP.md) ---------------------------
COPILOT_ENABLED=false
# Microsoft Entra directory (tenant) ID
ENTRA_TENANT_ID=
# The Thunai API app registration: Application ID URI and client ID, comma separated
ENTRA_AUDIENCE=
ENTRA_SCOPE=Thunai.Use
# Optional: link to the Thunai agent in Teams, shown on the PWA home screen
COPILOT_TEAMS_URL=

# --- Speech to text ---------------------------------------------------------------------------
# mock | openai_compat (self-hosted Whisper keeps audio on-premise) | sarvam | none
STT_PROVIDER=openai_compat
STT_BASE_URL=http://whisper:8000/v1
STT_MODEL=whisper-1
STT_API_KEY=
SARVAM_API_KEY=

# --- Similarity search (optional, SPEC section 11.5) -------------------------------------------
# none = keyword similarity only. openai_compat = any server with an OpenAI-style /embeddings
# endpoint (for example a multilingual model on the plant network). Run `python -m app.cli reindex`
# after switching it on.
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=multilingual-e5-base
EMBEDDINGS_API_KEY=

# --- Ports and backups --------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
