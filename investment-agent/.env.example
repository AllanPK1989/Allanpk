# Copy to backend/.env for local use. Never commit the real file.

# development | production   (production refuses to start without SECRET_KEY, a password and Postgres)
ENVIRONMENT=development
# live = Yahoo Finance, mfapi.in, Crypto.com, FRED, RSS.  demo = made-up data, works offline.
DATA_MODE=live

# SQLite locally; in the cloud, your Neon connection string (postgresql://...?sslmode=require)
DATABASE_URL=sqlite:///./data/invest.db

# Login. Generate the hash with:  python -m app.jobs hash-password
# (With ENVIRONMENT=development and no password, the app is open on localhost.)
OWNER_PASSWORD_HASH=
# Random 32+ characters:  python -c "import secrets; print(secrets.token_urlsafe(40))"
SECRET_KEY=
# Public address of the app (used in email/push links and for secure cookies)
BASE_URL=http://localhost:8000

# Claude (https://console.anthropic.com). Without it the app works with data-only digests.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-5-5
NEWS_MODEL=claude-haiku-5-5
ANALYSIS_EFFORT=medium
CHAT_EFFORT=medium

# Gmail: turn on 2-Step Verification, then create an App Password (Google Account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where digests go (defaults to GMAIL_USER)
DIGEST_TO=

# Web push keys:  python -m app.jobs vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (defaults to mailto:GMAIL_USER)
VAPID_SUBJECT=

TIMEZONE=Asia/Kolkata
