/// Cell hour counter month by month: opening, added, closing, trigger, carry-over.
table Fact_HourLedger
	lineageTag: 99735301-0cfe-4c04-a1d1-ffb5a303f89e

	column MonthKey
		dataType: string
		lineageTag: d6f88319-ede8-43ae-807f-55080042b77f
		summarizeBy: none
		sourceColumn: MonthKey

		annotation SummarizationSetBy = Automatic

	column CellID
		dataType: string
		lineageTag: 4deaad8e-3002-4f88-9be7-dae8ed08f94b
		summarizeBy: none
		sourceColumn: CellID

		annotation SummarizationSetBy = Automatic

	column CellName
		dataType: string
		lineageTag: 6dbdf1ef-a609-4d66-bb4f-f3a9c08f4436
		summarizeBy: none
		sourceColumn: CellName

