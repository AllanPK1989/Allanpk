/// Cell hour counter month by month: opening, added, closing, trigger, carry-over.
table Fact_HourLedger
	lineageTag: ae47a9df-0fd8-4e9a-a9a8-5c14afddc4b7

	column MonthKey
		dataType: string
		lineageTag: 1af09cf5-527c-48da-b0d1-bcecd527ec7b
		summarizeBy: none
		sourceColumn: MonthKey

		annotation SummarizationSetBy = Automatic

	column CellID
		dataType: string
		lineageTag: 95f9053a-a25a-4e49-92e3-f23b89f7668c
		summarizeBy: none
		sourceColumn: CellID

		annotation SummarizationSetBy = Automatic

	column CellName
		dataType: string
		lineageTag: 88e1130e-ace5-4d1d-81f7-98d3508ffb4c
		summarizeBy: none
		sourceColumn: CellName

		annotation SummarizationSetBy = Automatic

	column OpeningStdHrs
		dataType: double
		formatString: #,0.0
		lineageTag: abbdfbe4-1992-4ad6-8c79-56698042b2c7
		summarizeBy: none
		sourceColumn: OpeningStdHrs

		annotation SummarizationSetBy = Automatic

	column StdHoursAdded
		dataType: double
		formatString: #,0.0
		lineageTag: 1f5baa4a-cbe1-4368-9c04-f29fb43a2b0a
