/// Cell hour counter month by month: opening, added, closing, trigger, carry-over.
table Fact_HourLedger
	lineageTag: 3dbc6aba-8c00-4122-bdb4-19d3b1633f90

	column MonthKey
		dataType: string
		lineageTag: 86fea8c6-54f4-49f5-ac22-7b0f6b5109d4
		summarizeBy: none
		sourceColumn: MonthKey

		annotation SummarizationSetBy = Automatic

	column CellID
		dataType: string
		lineageTag: 9bb2f810-cd14-4227-af6d-b12af0a6fbb0
		summarizeBy: none
		sourceColumn: CellID

		annotation SummarizationSetBy = Automatic

	column CellName
		dataType: string
		lineageTag: b96dbea7-4fb0-4526-923c-c47484216510
		summarizeBy: none
		sourceColumn: CellName

		annotation SummarizationSetBy = Automatic

	column OpeningStdHrs
		dataType: double
		formatString: #,0.0
		lineageTag: d55ad32b-8093-43f1-a378-c99be7d31ac2
		summarizeBy: none
		sourceColumn: OpeningStdHrs

		annotation SummarizationSetBy = Automatic

	column StdHoursAdded
		dataType: double
		formatString: #,0.0
		lineageTag: c27bf195-f1e6-4713-aa27-0af7bf54b5b6
