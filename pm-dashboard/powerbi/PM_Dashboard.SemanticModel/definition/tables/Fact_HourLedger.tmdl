		sourceColumn: CarryOverAfterPM

		annotation SummarizationSetBy = Automatic

	column MonthsSinceLastPM
		dataType: int64
		formatString: #,0
		lineageTag: 7b1ec818-6568-4f60-a5a7-df94fc6f520d
		summarizeBy: none
		sourceColumn: MonthsSinceLastPM

