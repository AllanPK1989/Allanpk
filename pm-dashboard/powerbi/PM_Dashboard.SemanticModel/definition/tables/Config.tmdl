		lineageTag: cc096458-8f8e-478a-8567-17ed807122f2
		summarizeBy: none
		sourceColumn: DataType

		annotation SummarizationSetBy = Automatic

	column Description
		dataType: string
		lineageTag: 3e560d43-7100-477c-8787-1fda47aa3d92
		summarizeBy: none
