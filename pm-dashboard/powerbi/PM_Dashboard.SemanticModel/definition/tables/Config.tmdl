/// Key/value configuration. Read by measures via LOOKUPVALUE.
table Config
	lineageTag: 8b665d2b-3b92-41df-a940-b26e3a3cc8a1
	isHidden

	column ConfigKey
		dataType: string
		lineageTag: bc61351b-7a17-4889-bf2b-828602472d88
		summarizeBy: none
		sourceColumn: ConfigKey

		annotation SummarizationSetBy = Automatic

	column ConfigValue
		dataType: string
		lineageTag: ccf1c34a-a35a-4372-a4c2-3714fb35ede7
		summarizeBy: none
