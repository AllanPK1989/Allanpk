		annotation SummarizationSetBy = Automatic

	column TechName
		dataType: string
		lineageTag: 7396bca7-2f66-4a88-a251-c9f1ccaec044
		summarizeBy: none
		sourceColumn: TechName

		annotation SummarizationSetBy = Automatic

	column ScanDateTime
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 2addac91-d45f-4794-869f-081fe51cd999
		summarizeBy: none
		sourceColumn: ScanDateTime

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column LinkedWOID
		dataType: string
		lineageTag: cba5718d-8d06-4436-ba7a-64c7b44fc95c
		summarizeBy: none
		sourceColumn: LinkedWOID

		annotation SummarizationSetBy = Automatic

	column Action
		dataType: string
		lineageTag: 9459bd5e-2592-4661-8d93-d5db0382a88b
