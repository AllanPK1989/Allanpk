		annotation SummarizationSetBy = Automatic

	column MachineName
		dataType: string
		lineageTag: b575424f-bf74-49e8-a121-aa8cc5abfae6
		summarizeBy: none
		sourceColumn: MachineName

		annotation SummarizationSetBy = Automatic

	column TechID
		dataType: string
		lineageTag: 5c10a01d-bdd0-49f4-92de-82157527ad10
		summarizeBy: none
