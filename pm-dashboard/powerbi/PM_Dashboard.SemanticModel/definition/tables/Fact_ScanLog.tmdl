	column MachineName
		dataType: string
		lineageTag: 0de645b6-e80d-4dcb-b7c3-15a56f5d3c7f
		summarizeBy: none
		sourceColumn: MachineName

		annotation SummarizationSetBy = Automatic

	column TechID
		dataType: string
		lineageTag: 0ff0fa48-186c-4bcf-9dce-5c1aa95c47f3
		summarizeBy: none
		sourceColumn: TechID

