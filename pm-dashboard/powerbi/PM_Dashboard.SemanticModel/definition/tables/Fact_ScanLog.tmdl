		sourceColumn: ScanDateTime

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column LinkedWOID
		dataType: string
		lineageTag: 0e80e9e3-6ff7-4ed1-a887-141a1182d5af
		summarizeBy: none
		sourceColumn: LinkedWOID

		annotation SummarizationSetBy = Automatic

	column Action
		dataType: string
		lineageTag: 37e70bfc-9c91-47f9-9271-e3c2587acd7b
		summarizeBy: none
