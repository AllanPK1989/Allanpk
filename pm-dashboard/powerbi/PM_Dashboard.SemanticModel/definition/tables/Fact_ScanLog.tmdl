		annotation SummarizationSetBy = Automatic

	column MachineName
		dataType: string
		lineageTag: f6812bbc-ed56-42ea-bc2d-a41f4ccca7e6
		summarizeBy: none
		sourceColumn: MachineName

		annotation SummarizationSetBy = Automatic

	column TechID
		dataType: string
		lineageTag: ab0b4263-53d2-4e8a-a5e3-71ba3f9d927d
		summarizeBy: none
		sourceColumn: TechID

		annotation SummarizationSetBy = Automatic

	column TechName
		dataType: string
		lineageTag: 53e380a0-015a-4fed-bc35-a2471d619550
		summarizeBy: none
		sourceColumn: TechName

		annotation SummarizationSetBy = Automatic

	column ScanDateTime
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: ac9cb6dc-c35f-4e87-b0a2-26a4d402e7f1
		summarizeBy: none
		sourceColumn: ScanDateTime

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column LinkedWOID
		dataType: string
		lineageTag: b8ec9977-b2a8-485d-81a9-9f66ce2dd865
		summarizeBy: none
		sourceColumn: LinkedWOID

		annotation SummarizationSetBy = Automatic

	column Action
		dataType: string
		lineageTag: 8711d904-2c6e-4595-96be-de3fe5b64b56
		summarizeBy: none
