/// Every QR scan. Proves attendance at the machine.
table Fact_ScanLog
	lineageTag: 625d191a-6fbd-4021-b0fd-d41a6eabfb82

	column ScanID
		dataType: string
		lineageTag: 0ab80163-75fe-4f0a-8397-d90d26cdfaa9
		summarizeBy: none
		sourceColumn: ScanID

		annotation SummarizationSetBy = Automatic

	column QRType
		dataType: string
		lineageTag: 7cbf1163-957f-409e-86d2-01bdf2038535
		summarizeBy: none
