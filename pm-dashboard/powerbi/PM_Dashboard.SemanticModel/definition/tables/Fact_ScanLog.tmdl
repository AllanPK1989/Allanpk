	column TechName
		dataType: string
		lineageTag: a3e84017-daa8-4d5f-9e4f-3f0a9e4770d3
		summarizeBy: none
		sourceColumn: TechName

		annotation SummarizationSetBy = Automatic

	column ScanDateTime
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 201c3a8d-8d9f-45a8-843f-0d5191e77b4b
