/// Every QR scan. Proves attendance at the machine.
table Fact_ScanLog
	lineageTag: b7febfee-078c-4a81-9e98-6da0825a8250

	column ScanID
		dataType: string
		lineageTag: b15b54e8-8f01-4381-8889-f8fa46322311
		summarizeBy: none
		sourceColumn: ScanID

		annotation SummarizationSetBy = Automatic

	column QRType
		dataType: string
		lineageTag: 266bd4b7-fc51-4d6d-b07d-a59dccc1fcf1
		summarizeBy: none
