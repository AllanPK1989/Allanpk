/// Every QR scan. Proves attendance at the machine.
table Fact_ScanLog
	lineageTag: 8b5d054c-dce5-4a31-a276-be06782afa4d

	column ScanID
		dataType: string
		lineageTag: 82d28eef-43fb-4c7f-b309-e1e47336a619
		summarizeBy: none
		sourceColumn: ScanID

		annotation SummarizationSetBy = Automatic

	column QRType
		dataType: string
		lineageTag: 267e8d8d-36b6-4eb5-b017-104d97447044
		summarizeBy: none
