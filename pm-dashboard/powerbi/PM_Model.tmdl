				dataType: string
				lineageTag: 98fab7f8-bfe3-5511-b863-ef26f8569953
				summarizeBy: none
				sourceColumn: ScanID

				annotation SummarizationSetBy = Automatic

			column QRType
				dataType: string
				lineageTag: 0cf134dd-7d11-58fe-9324-4caa0d9651e7
				summarizeBy: none
				sourceColumn: QRType

				annotation SummarizationSetBy = Automatic

			column MachineID
				dataType: string
				lineageTag: fb0de84b-698f-552e-8691-1353edc49f7d
				summarizeBy: none
