# Copy to .env and edit. Every value has a working default.

# --- live quotes ----------------------------------------------------------
# Yahoo and Stooq are free and keyless, but both refuse datacentre IPs: on
# Render they answer 429 and 404 respectively, and the dashboard falls back to
# the statement close. Set a free Finnhub key (finnhub.io/register, 60 calls a
# minute) to get live prices from a deployed host. Running on your own machine,
# Yahoo usually works and no key is needed.
FINNHUB_API_KEY=

# Seconds a quote is reused before refetching. Lower = fresher, more requests.
QUOTE_TTL=60

# --- access ---------------------------------------------------------------
# Shared secret. LEAVE EMPTY for localhost. SET IT before exposing the app to
# the internet — without it, anyone with the URL sees your positions.
# Clients pass it as ?token=... or an X-App-Token header.
APP_TOKEN=

# --- misc -----------------------------------------------------------------
PORT=8000
SKIP_WARMUP=
LOG_LEVEL=INFO
